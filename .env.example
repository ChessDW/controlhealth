# Copy these values into Railway Variables or a local .env file. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMERGENCY_EMAIL_FROM=

# Solo para crear el primer administrador durante un despliegue.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
